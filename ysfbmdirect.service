[Unit]
Description=YSFBMDirect - YSF to Brandmeister Bridge
After=multi-user.target

[Service]
Type=simple
Restart=always
RestartSec=10
WorkingDirectory=/opt/YSFBMDirect
ExecStart=/opt/YSFBMDirect/.venv/bin/ysfbmdirect config.yaml
StandardOutput=append:/var/log/pi-star/YSFBMDirect.log
StandardError=append:/var/log/pi-star/YSFBMDirect.log

[Install]
WantedBy=multi-user.target